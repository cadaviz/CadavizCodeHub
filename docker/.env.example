# *** GENERAL CONFIGURATION *** 

# Works with Development, Test and Production values
ASPNETCORE_ENVIRONMENT=Development

DOTNET_RUNNING_IN_CONTAINER=TRUE

# *** ORDERS CONFIGURATION ***

# WebAPI Configuration
ORDERS_WEBAPI_CONTAINER_NAME=cadaviz-code-hub_orders_webapi
ORDERS_WEBAPI_URLS=https://+:8081
ORDERS_WEBAPI_HTTP_PORT=8080
ORDERS_WEBAPI_HTTPS_PORT=8081

# MongoDB Configuration
ORDERS_MONGO_IMAGE=mongo:latest
ORDERS_MONGO_CONTAINER_NAME=cadaviz-code-hub_orders_mongodb
ORDERS_MONGO_INITIAL_DATABASE_NAME=Cadaviz_OrderDB
ORDERS_MONGO_PORT=27017
ORDERS_MONGO_USERNAME=
ORDERS_MONGO_PASSWORD=